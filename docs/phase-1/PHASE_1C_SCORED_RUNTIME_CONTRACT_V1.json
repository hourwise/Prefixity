  },
  "invalidation_rules": [
    "any contract, source, task, transformation, evaluator, policy, or arm-order hash mismatch",
    "any provider/model/API/endpoint/settings/seed/reasoning/timeout drift",
    "any credential read, exposure, redirect, retry, fallback, warmup, or unplanned request",
    "any missing required accounting, terminal content, tool outcome, or identity field",
