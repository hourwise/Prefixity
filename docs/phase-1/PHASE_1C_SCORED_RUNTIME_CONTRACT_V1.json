  "fingerprint": {
    "algorithm": "SHA-256",
    "canonicalization": "sorted JSON object keys; arrays preserve order",
    "recorded_in": "docs/phase-1/PHASE_1C_SCORED_RUNTIME_CONTRACT_V1.sha256"
  }
