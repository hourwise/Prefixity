{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract_version": "phase1c-scored-runtime-local-qwen-v1",
  "experiment_id": "phase-1c-scored-capability-v1",
  "status": "DESIGN_ONLY_NO_INFERENCE_AUTHORIZED",
  "phase": "phase-1c",
  "purpose": "quality_gated_capability_replay",
  "engine": "llama.cpp",
  "runtime": "llama-server",
  "runtime_version": "record_exact_at_execution",
  "server_executable_family": ["llama", "llama-server"],
  "api_surface": "llama.cpp-openai-compatible-chat-completions-v1",
  "endpoint": "http://127.0.0.1:8080/v1/chat/completions",
  "host": "127.0.0.1",
  "port": 8080,
  "model": "ggml-org/Qwen3.5-0.8B-GGUF:Q4_0",
  "quantization": "Q4_0",
  "context_size": 8192,
  "parallel_slots": 1,
  "metrics": "enabled",
  "chat_template": {
    "policy": "model-embedded-default",
    "override": false,
    "record_resolved_template_at_execution": true
  },
  "credential_policy": {
    "required": false,
    "authorization_header": "none",
    "credential_environment_variable": "none",
    "account": "not applicable",
    "region": "not applicable",
    "pricing_spend_profile": "local runtime — no provider spend",
    "provider_api_key_read": false
  },
  "generation": {
    "temperature": 0,
    "top_p": 1,
    "max_tokens": 2048,
    "stream": false,
    "tool_choice": "task-declared",
    "seed": {
      "value": 1,
      "policy": "fixed_and_recorded",
      "status": "must_be_applied_or_abort"
    },
    "additional_sampling_parameters": {}
  },
  "timeout_policy": {
    "connect_timeout_ms": 1000,
    "complete_request_timeout_ms": 600000,
    "supervisor_timeout_ms": 660000
  },
  "retry_policy": {
    "automatic_retries": 0,
    "fallback_requests": 0,
    "adaptive_replicates": 0,
    "post_consumption_recovery": "forbidden"
  },
  "request_ceiling": {
    "per_arm_replicate_max_model_turns": 3,
    "pilot_max_model_inference_requests": 54,
    "full_cohort_planned_max_model_inference_requests": 216,
    "unplanned_inference": "forbidden"
  },
  "input_output_budget": {
    "input_context_ceiling_tokens": 6144,
    "output_ceiling_tokens": 2048,
    "context_plus_output_ceiling_tokens": 8192,
    "analysis_basis": "offline review of the existing twelve-task cohort, evaluator obligations, and compact protocol/final-answer shapes",
    "smoke_01_ceiling_tokens": 256,
    "smoke_01_ceiling_is_not_reused": true,
    "estimated_final_answer_ceiling_tokens": 512,
    "estimated_reasoning_reserve_tokens": 1536,
    "estimate_status": "design_estimate_not_measurement",
    "truncation_policy": "finish_reason=length or missing terminal final content is INCONCLUSIVE; no retry or ceiling increase"
  },
  "runtime_settings": {
    "reasoning": "on",
    "reasoning_request_argument": ["--reasoning", "on"],
    "same_for_all_arms_and_replicates": true
  },
  "launch": {
    "executable": "llama",
    "arguments": [
      "serve",
      "-hf",
      "ggml-org/Qwen3.5-0.8B-GGUF:Q4_0",
      "-c",
      "8192",
      "-np",
      "1",
      "--metrics",
      "--reasoning",
      "on",
      "--host",
      "127.0.0.1",
      "--port",
      "8080"
    ]
  },
  "freshness_cache_isolation": {
    "fresh_server_process_per_arm_replicate": true,
    "zero_inference_requests_since_startup": true,
    "maximum_non_inference_listener_checks_per_server": 1,
    "listener_check": "bounded TCP listener check only; no HTTP readiness probe",
    "warmup": false,
    "cache_reuse_across_arms": false,
    "cache_reuse_across_replicates": false,
    "cache_claim_boundary": "record runtime telemetry but make no provider-cache or billed-cost claim from local metrics alone",
    "arm_advance_rule": "persist and validate the complete prior arm before starting the next arm"
  },
  "input_schema_id": "prefixity.phase1c.scored-capability-request-v1",
  "output_schema_id": "prefixity.phase1c.scored-capability-evidence-v1",
  "response_extraction": {
    "final_content_json_pointer": "/choices/0/message/content",
    "reasoning_content_json_pointer": "/choices/0/message/reasoning_content",
    "tool_calls_json_pointer": "/choices/0/message/tool_calls",
    "final_content_required_for_terminal_turn": true,
    "intermediate_tool_turn_empty_content_allowed": true,
    "missing_reasoning_content": "allowed_and_recorded",
    "reasoning_content_status": "diagnostic_only_separate_field",
    "reasoning_content_substitution_for_final_content": "forbidden",
    "raw_response_retention": "bounded_and_hashed"
  },
  "reasoning_isolation": {
    "fed_to_later_turns": false,
    "fed_to_later_arms": false,
    "fed_to_prefixity_treatment": false,
    "fed_to_evaluator": false,
    "affects_task_identity": false,
    "affects_arm_identity": false,
    "affects_treatment_identity": false,
    "affects_expected_answer_or_hidden_labels": false,
    "retained_separately_from_final_answer": true,
    "privacy_review_required_before_retention": true
  },
  "evidence_persistence": {
    "design_evidence_location": "experiments/runs/phase1c-scored-capability-v1",
    "live_evidence_is_ignored_and_not_committed": true,
    "per_arm_artifacts": [
      "preflight.json",
      "request-turn-<n>.json",
      "response-turn-<n>.bin",
      "normalized-turn-<n>.json",
      "arm-result.json"
    ],
    "required_identity_fields": [
      "experiment_id",
      "task_id",
      "arm",
      "replicate",
      "turn",
      "runtime_contract_sha256",
      "request_sha256",
      "response_sha256"
    ],
    "credential_redaction": "required_before_persistence",
    "preserved_reasoning_field": "normalized-turn-<n>.json.reasoning_content_diagnostic"
  },
  "scoring_boundary": {
    "primary_evaluator": "Tier 0 structural plus Tier 2 deterministic task/tool checks",
    "evaluator_version": "stage0-deterministic-evaluator-v1",
    "evaluation_key": "sidecar_only_not_in_prompt_or_treatment_input",
    "score_source": "terminal_final_message_content_and_declared_tool_outcomes",
    "reasoning_score": "none",
    "baseline_pass_intervention_fail": "hard_failure_not_averaged_away",
    "incomplete_or_ambiguous": "INCONCLUSIVE",
    "claim_scope": "named frozen cohort and exact registered local runtime only"
  },
  "arm_matching_requirements": [
    "same contract, model, quantization, context, slots, metrics, reasoning, sampling, seed, timeouts, and retry policy",
    "same task identity, system/developer instructions, tool contract, authentication material, and evaluator procedure",
    "BASELINE and NO_OP request/context bytes are identical apart from run metadata",
    "INTERVENTION differs only by the declared frozen candidate transformation on a disposable copy",
    "same arm order and replicate policy for every task",
    "reasoning content is never an arm-specific hidden variable"
  ],
  "candidate": {
