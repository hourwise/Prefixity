{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:prefixity:controlled-benchmark:v1",
  "title": "Prefixity controlled benchmark trace envelope",
  "description": "Design-only, provider-neutral trace shape. The trace input and evaluation sidecar are deliberately separate so a planner loader can select only planner_input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "benchmark_id",
    "scenario",
    "trace",
    "evaluation_sidecar"
  ],
  "properties": {
    "schema_id": {
      "const": "prefixity.controlled-benchmark"
    },
    "schema_version": {
      "const": 1
    },
    "benchmark_id": {
      "$ref": "#/$defs/id"
    },
    "scenario": {
      "$ref": "#/$defs/scenario"
    },
    "trace": {
      "$ref": "#/$defs/trace"
    },
    "evaluation_sidecar": {
      "$ref": "#/$defs/evaluationSidecar"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "boundedText": {
      "type": "string",
      "maxLength": 512
    },
    "classification": {
      "type": "string",
      "enum": [
        "CAPTURED_EXPLICIT",
        "DERIVED_STRUCTURAL",
        "EVALUATION_ONLY",
        "INFERRED_UNSAFE",
        "ABSENT"
      ]
    },
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "classification"
      ],
      "properties": {
        "source_kind": {
          "type": "string",
          "enum": [
            "self_authored",
            "pinned_public_metadata",
            "public_design_reference"
          ]
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "source_locator": {
          "type": "string",
          "maxLength": 512
        },
        "source_revision": {
          "$ref": "#/$defs/boundedText"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "note": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_version",
        "task_revision",
        "environment_revision",
        "initial_state_id",
        "fixed_seed",
        "provenance"
      ],
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/id"
        },
        "scenario_version": {
          "type": "string",
          "pattern": "^v[0-9]+$"
        },
        "task_revision": {
          "$ref": "#/$defs/boundedText"
        },
        "environment_revision": {
          "$ref": "#/$defs/boundedText"
        },
        "initial_state_id": {
          "$ref": "#/$defs/id"
        },
        "fixed_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceProvenance"
          },
          "maxItems": 16
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "variant_role",
        "baseline_trace_id",
        "planner_input"
      ],
      "properties": {
        "trace_id": {
          "$ref": "#/$defs/id"
        },
        "variant_role": {
          "type": "string",
          "enum": [
            "baseline",
            "variant",
            "control"
          ]
        },
        "baseline_trace_id": {
          "$ref": "#/$defs/id"
        },
        "planner_input": {
          "$ref": "#/$defs/plannerInput"
        }
      }
    },
    "plannerInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "relations",
        "provenance"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/event"
          }
        },
        "relations": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceProvenance"
          },
          "maxItems": 512
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence_index",
        "event_type",
        "actor_role",
        "provenance"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "sequence_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "event_type": {
          "type": "string",
          "enum": [
            "message",
            "action",
            "result",
            "observation",
            "state_snapshot",
            "assertion"
          ]
        },
        "actor_role": {
          "type": "string",
          "enum": [
            "system",
            "user",
            "agent",
            "tool",
            "environment",
            "evaluator"
          ]
        },
        "parent_event_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "reference_event_ids": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "action": {
          "$ref": "#/$defs/action"
        },
        "result": {
          "$ref": "#/$defs/result"
        },
        "context_block_id": {
          "$ref": "#/$defs/id"
        },
        "world_state_revision": {
          "$ref": "#/$defs/id"
        },
        "order": {
          "$ref": "#/$defs/order"
        },
        "content_hash": {
          "$ref": "#/$defs/sha256"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/sourceProvenance"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "tool_name"
      ],
      "properties": {
        "action_id": {
          "$ref": "#/$defs/id"
        },
        "tool_name": {
          "$ref": "#/$defs/boundedText"
        },
        "argument_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "originating_action_id"
      ],
      "properties": {
        "result_id": {
          "$ref": "#/$defs/id"
        },
        "originating_action_id": {
          "$ref": "#/$defs/id"
        },
        "observation_hash": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "failure",
            "empty",
            "unknown"
          ]
        }
      }
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logical_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "source_timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "timestamp_origin": {
          "type": "string",
          "enum": [
            "source_explicit",
            "derived_structural"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_id",
        "relation_type",
        "from_id",
        "to_id",
        "scope",
        "provenance"
      ],
      "properties": {
        "relation_id": {
          "$ref": "#/$defs/id"
        },
        "relation_type": {
          "type": "string",
          "enum": [
            "produces",
            "references",
            "depends_on",
            "supersedes",
            "invalidates",
            "protocol_precedes",
            "same_state_revision"
          ]
        },
        "from_id": {
          "$ref": "#/$defs/id"
        },
        "to_id": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "const": "scenario_local"
        },
        "semantics_version": {
          "type": "string",
          "const": "controlled-benchmark-relations-v1"
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/sourceProvenance"
          }
        }
      }
    },
    "evaluationSidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intervention_manifest_ref",
        "intervention_manifest",
        "quality_evaluation_ids"
      ],
      "properties": {
        "intervention_manifest_ref": {
          "$ref": "#/$defs/id"
        },
        "intervention_manifest": {
          "$ref": "#/$defs/interventionManifest"
        },
        "quality_evaluation_ids": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "oracle_result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "INVALID_BASELINE",
            "INCONCLUSIVE"
          ]
        },
        "evaluation_content_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "interventionManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_id",
        "baseline_trace_id",
        "variant_trace_id",
        "target_event_ids",
        "intervention_class",
        "exact_transformation",
        "reason",
        "planner_visibility",
        "expected_structural_effect",
        "expected_quality_risk_category"
      ],
      "properties": {
        "manifest_id": {
          "$ref": "#/$defs/id"
        },
        "baseline_trace_id": {
          "$ref": "#/$defs/id"
        },
        "variant_trace_id": {
          "$ref": "#/$defs/id"
        },
        "target_event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "intervention_class": {
          "type": "string",
          "enum": [
            "remove",
            "defer",
            "relocate",
            "compress",
            "no_change"
          ]
        },
        "exact_transformation": {
          "$ref": "#/$defs/boundedText"
        },
        "reason": {
          "$ref": "#/$defs/boundedText"
        },
        "planner_visibility": {
          "type": "string",
          "enum": [
            "planner_visible",
            "evaluation_only"
          ]
        },
        "expected_structural_effect": {
          "$ref": "#/$defs/boundedText"
        },
        "expected_quality_risk_category": {
          "type": "string",
          "enum": [
            "none",
            "low",
            "low_if_boundary_preserved",
            "low_if_order_constraints_hold",
            "high",
            "unknown"
          ]
        }
      }
    }
  }
}
